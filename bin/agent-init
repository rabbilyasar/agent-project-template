#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s <project-directory>\n' "$(basename "$0")"
}

if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
    usage
    exit 0
fi

[[ $# -eq 1 ]] || {
    usage >&2
    exit 2
}

if [[ "$1" == -* ]]; then
    printf 'Error: unknown option: %s\n' "$1" >&2
    usage >&2
    exit 2
fi

project_dir=$1

if [[ -e "$project_dir" && ! -d "$project_dir" ]]; then
    printf 'Error: not a directory: %s\n' "$project_dir" >&2
    exit 1
fi

mkdir -p "$project_dir"

template_root="${AGENT_INIT_TEMPLATE_DIR:-$HOME/.local/share/agent-init}"

if [[ ! -d "$template_root" ]]; then
    printf 'Error: template directory not found: %s\n' "$template_root" >&2
    exit 1
fi

files=(
    "AGENTS.md"
    ".agent/current-task.md"
    ".agent/roadmap.md"
    ".agent/state.md"
    "docs/requirements.md"
    "docs/architecture.md"
    "docs/decisions.md"
    "docs/development.md"
    "docs/troubleshooting.md"
)

created=0
skipped=0

for file in "${files[@]}"; do
    source="$template_root/$file"
    destination="$project_dir/$file"

    if [[ ! -f "$source" ]]; then
        printf 'Error: template file not found: %s\n' "$source" >&2
        exit 1
    fi

    if [[ -e "$destination" ]]; then
        printf 'SKIP     %s\n' "$file"
        ((skipped += 1))
        continue
    fi

    mkdir -p "$(dirname -- "$destination")"
    sed "s/YYYY-MM-DD/$(date +%Y-%m-%d)/g" "$source" > "$destination"

    printf 'CREATE   %s\n' "$file"
    ((created += 1))
done

printf '\nInitialized agent infrastructure in: %s\n' "$project_dir"
printf 'Created: %d  Skipped: %d\n' "$created" "$skipped"
